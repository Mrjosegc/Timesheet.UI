@{
    var ListaDepartamentos = ViewBag.ListaDepartamentos;

}

<head>

    <link href="~/css/mantusuariocss/mantusuario.css" rel="stylesheet" />
    <script defer src="~/js/MantDepartamentosJS/MantDepartamentos.js"></script>

</head>


<h1 class="LineaTitulo text-center" >Mantenimiento de Departamentos
</h1>


<div class="TabDepartamentos">
    <nav>
        <div class="nav nav-tabs" id="nav-tab" role="tablist">

        </div>
    </nav>
    <div class="tab-content" id="nav-tabContent">
        <div class="tab-pane fade show active" id="nav-home" role="tabpanel" aria-labelledby="nav-home-tab" tabindex="0">

            <div class="row ContenidoTab">

                <h4 class="LineaTitulo">Crear nuevo Departamento</h4>

                <div class="col-4">
                    <label class="form-label">Nombre del Departamento:</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-address-card"></i></span>
                        <input type="text" class="form-control" id="InputNombreDepartamento" placeholder="Ingrese el nombre del Departamento" />
                    </div>
                </div>

                <div class="col-4">
                    <label class="form-label">Descripción del Departamento:</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-address-card"></i></span>
                        <input type="text" class="form-control" id="InputDescripcionDepartamento" placeholder="Ingrese Descripción corta" />
                    </div>
                </div>
            </div>

            <div class="col-4 BotonesCrearCancelar">

                <button class="btn btn-primary mt-2" id="btnCrearDepartamento"><i class="fa-solid fa-floppy-disk"></i>&nbsp;Crear Departamento</button>
            </div>

                <!--Inicio Tabla Departamentos-->
                <h4 class="LineaTitulo mt-4">Departamentos actuales</h4>
                <table id="TbDepartamentos" class="table table-light table-hover mt-1 mb-5">
                    <thead>
                        <tr>
                            <th>IdDepartamento</th>
                            <th>Nombre del Departamento</th>
                            <th>Descripcion del Departamento</th>
                            <th>Estado</th>
                            <th>Fecha de creación</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var usr in ListaDepartamentos)
                        {
                            <tr>
                                <td>@usr.IdDepartamento</td>
                                <td>@usr.NombreDepartamento</td>
                                <td>@usr.DescripcionDepartamento</td>
                                <td>
                                    @if (usr.EstadoDepartamento)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td>@usr.FechaCreacionDepartamento.ToString("dd/MM/yyyy")</td>
                                <td>

                                <button class="btn-warning btnObtenerDepartamentoPorId" data-id-departamento="@usr.IdDepartamento" data-bs-toggle="modal" data-bs-target="#modalEditarDepartamentoPorId"><i class="fa-regular fa-pen-to-square"></i>&nbsp;Editar</button>
                                <button class="btn-danger btnEliminarDepartamento" data-idDepartamento="@usr.IdDepartamento"><i class="fa-regular fa-trash-can"></i> &nbsp;Eliminar</button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

                <!--Fin Tabla Departamentos-->

        </div>
    </div>
</div>
<!-- Modal: Editar Departamento -->
<div class="modal fade" id="modalEditarDepartamentoPorId" tabindex="-1" aria-labelledby="tituloModalDepartamento" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 80vw;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalDepartamento">
                    <i class="fa-solid fa-user-gear me-2"></i>Editar Departamento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <!-- (Opcional) ID oculto del usuario -->
                <input class="form-control" type="text" id="ModalInputIdDepartamento" hidden />

                <div class="container-fluid">
                    <div class="row g-3">
                        <div class="col-12">
                            <h6 class="mb-2 text-body-secondary">Datos de acceso</h6>
                            <hr class="mt-0 mb-3">
                        </div>

                        <div class="col-4">
                            <label class="form-label">Nombre del Departamento:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-arrows-down-to-people"></i></span>
                                <input class="form-control" id="ModalInputNombreDepartamento" type="text" placeholder="Ingrese el nombre del Departamento" />
                            </div>
                        </div>

                        <div class="col-4">
                            <label class="form-label">Descripción del Departamento:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-align-left"></i></span>
                                <input class="form-control" id="ModalInputDescripcionDepartamento" type="text" placeholder="Ingrese Descripción corta" />
                            </div>
                        </div>
                        <div class="col-4">
                            <label class="form-label">Estado:</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fa-solid fa-toggle-on"></i>
                                </span>
                                <select class="form-select" id="ModalSelectEstadoDepartamento">
                                    <option value="true">Activo</option>
                                    <option value="false">Inactivo</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer d-flex justify-content-between">

                <div>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="ModalbtnCancelarDepartamento"><i class="fa-solid fa-xmark"></i>&nbsp;Cancelar</button>
                    <button type="button" class="btn btn-primary" id="ModalbtnGuardarDepartamento"><i class="fa-solid fa-floppy-disk"></i>&nbsp;Guardar cambios</button>

                </div>
            </div>
        </div>
    </div>
</div>

