@{
    ViewData["Title"] = "Reportes";
}

@using CRUD.ENTIDADES

@{
    ViewData["Title"] = "Reportes";

    List<UsuarioDTO> listaUsuarios = ViewBag.ListaUsuarios;
}


<div class="container-fluid">

    <!-- Encabezado -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-chart-bar mr-2"></i>
            Reportes de TimeSheet
        </h1>
    </div>

    <!-- Tarjeta de filtros -->
    <div class="card shadow mb-4">

        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                Filtros de búsqueda
            </h6>
        </div>

        <div class="card-body">

            <div class="row">

                @if (ViewBag.EsAdministrador)
                {
                    <div class="col-md-4 mb-3">

                        <label>Empleado</label>

                        <input type="hidden" id="txtIdEmpleado" value="0" />

                        <div class="input-group">

                            <input type="text"
                                   id="txtEmpleado"
                                   class="form-control"
                                   placeholder="Todos los empleados"
                                   readonly />

                            <button class="btn btn-outline-primary"
                                    type="button"
                                    id="btnBuscarEmpleado">

                                <i class="fas fa-search"></i>

                            </button>

                        </div>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label>Departamento</label>

                        <select id="ddlDepartamento"
                                class="form-control">

                            <option value="0">
                                Todos los departamentos
                            </option>

                        </select>

                    </div>
                }

                <div class="col-md-2 mb-3">
                    <label>Desde</label>
                    <input type="date"
                           id="txtFechaInicio"
                           class="form-control" />
                </div>

                <div class="col-md-2 mb-3">
                    <label>Hasta</label>
                    <input type="date"
                           id="txtFechaFin"
                           class="form-control" />
                </div>

            </div>

            <div class="text-right">

                <button id="btnGenerarReporte"
                        class="btn btn-primary">

                    <i class="fas fa-search mr-1"></i>
                    Generar Reporte

                </button>

            </div>

        </div>

    </div>

    <!-- Tarjeta del reporte -->
    <div class="card shadow">

        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                Reporte General
            </h6>
        </div>

        <div class="card-body">

            <!-- Mensaje inicial -->

            <div id="MensajeInicialReporte" class="text-center py-5">

                <i class="fas fa-chart-line fa-4x text-gray-300 mb-3"></i>

                <h5 class="text-gray-600">
                    Reporte no generado
                </h5>

                <p class="text-muted">
                    Seleccione los filtros de búsqueda y presione
                    <strong>"Generar Reporte"</strong>.
                </p>

            </div>

            <!-- Tabla -->

            <div id="ContenedorTablaReporte" style="display:none;">

                <!-- Encabezado del Reporte -->
                <div class="container-fluid mb-3">

                    <div class="row">

                        <div class="col-md-6 pe-4">
                            <strong>Empleado:</strong>
                            <span id="LblEmpleadoReporte"></span>
                        </div>

                        <div class="col-md-6 ps-4">
                            <strong>Departamento:</strong>
                            <span id="LblDepartamentoReporte"></span>
                        </div>

                    </div>

                    <div class="row mt-2">

                        <div class="col-md-6 pe-4">
                            <strong>Período:</strong>
                            <span id="LblPeriodoReporte"></span>
                        </div>

                        <div class="col-md-6 ps-4">
                            <strong>Fecha del reporte:</strong>
                            <span id="LblFechaReporte"></span>
                        </div>

                    </div>

                </div>

                <div class="table-responsive">

                    <table id="TbReporteTimeSheet"
                           class="table table-bordered table-hover w-100">

                        <thead class="thead-light">

                            <tr>

                                <th>Fecha</th>
                                <th>Entrada</th>
                                <th>Salida</th>
                                <th>Horas Trabajadas</th>
                                <th>Horas Extra</th>
                                <th>Justificación</th>

                            </tr>

                        </thead>

                        <tbody id="BodyReporteTimeSheet">
                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>
<!-- Modal: Buscar Empleado -->
<div class="modal fade"
     id="modalBuscarEmpleado"
     tabindex="-1"
     aria-hidden="true"
     data-bs-backdrop="static">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    <i class="fas fa-users me-2"></i>
                    Seleccionar Empleado
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <p class="text-muted">
                    Seleccione un empleado para generar el reporte.
                </p>

                <div class="table-responsive">

                        <table id="TbBuscarEmpleado"
                               class="table table-bordered table-hover w-100">

                            <thead>

                                <tr>

                                    <th>Empleado</th>
                                    <th>Departamento</th>
                                    <th>Puesto</th>
                                    <th>Acción</th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var usuario in ViewBag.ListaUsuarios)
                                {
                                    <tr>

                                        <td>@usuario.NombreCompleto</td>
                                        <td>@usuario.NombreDepartamento</td>
                                        <td>@usuario.NombreRol</td>

                                        <td class="text-center">

                                        <button class="btn btn-primary btn-sm btnSeleccionarEmpleado"
                                                data-id="@usuario.IdUsuario"
                                                data-nombre="@usuario.NombreCompleto">
                                            <i class="fas fa-check"></i>
                                            Seleccionar
                                        </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                </p>

            </div>

        </div>

    </div>

</div>
@section Scripts {

    <script src="~/js/TimeSheetJS/TimeSheet.js" asp-append-version="true"></script>

}